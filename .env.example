# Neon PostgreSQL connection strings.
# Create a project at https://neon.tech and use its dev branch here.
# Copy this file to `.env` and fill in the values from the Neon dashboard.

# Pooled connection (PgBouncer, host ends in `-pooler`) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Direct (unpooled, no `-pooler`) connection — used by Prisma Migrate / the CLI.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
